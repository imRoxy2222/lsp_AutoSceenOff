<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Android 11（API 30）起有「包可见性」限制：默认只能看到极少数应用，
      queryIntentActivities / getInstalledApplications 都会返回不全。
      要让「添加应用」能列出手机上全部软件，必须显式声明。

      用 QUERY_ALL_PACKAGES 是为了连没有桌面图标的系统组件也能列出来并申请。
      本模块不上架应用商店，不受商店对该权限的政策限制。
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- 双保险：部分 ROM 会限制 QUERY_ALL_PACKAGES，有这条至少能看到所有有界面的应用 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:description="@string/module_description"
        android:theme="@style/Theme.AutoScreenOffCode">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AutoScreenOffCode"
            android:windowSoftInputMode="adjustResize">
            <!--
              注意：这里刻意【不】配 LAUNCHER。桌面入口由下面的 activity-alias 提供，
              这样「隐藏桌面图标」只要禁用那个 alias 就行，而这个 Activity 本身始终可用。

              de.robv.android.xposed.category.MODULE_SETTINGS 是 Xposed 生态的惯例 category：
              LSPosed 的「启动」菜单会优先查它并用 setClassName 显式启动，
              与有没有桌面图标无关 —— 所以隐藏图标后依然能从 LSPosed 打开本模块。
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面图标。隐藏图标 = 把这个 alias 置为 DISABLED -->
        <activity-alias
            android:name=".LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity"
            android:theme="@style/Theme.AutoScreenOffCode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>